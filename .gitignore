# Secrets, environments, caches and editor state
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json
*secrets*.json
.venv/
venv/
__pycache__/
*.py[cod]
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.codex/
.agents/
.codex-log/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local source data, raw traces, scratch work and recoverable backups
results/
starter/data/
starter/results/
tmp/
temp/
.archive/
*.log
*.pdf
*.sqlite*
*.db
*.dump
*.sql.gz
*.zip
*.7z
*.tar*

# Only the published benchmark inputs may be added under data.
/data/*
!/data/README.md
!/data/agent_cases_example.json
!/data/example_chunks.json
!/data/example_questions.json
!/data/benchmark/
/data/benchmark/*
!/data/benchmark/dev.json
!/data/benchmark/test.json
!/data/bonus/
/data/bonus/*
!/data/bonus/benchmark/
/data/bonus/benchmark/*
!/data/bonus/benchmark/dev_questions.json
!/data/bonus/benchmark/dev_gold.json
!/data/bonus/benchmark/test_questions.json
!/data/bonus/benchmark/test_gold.json

# Planning and chat memory are not submission evidence.
/specs/
/.specify/
/AGENTS.md
/docs/*HANDOFF*.md

