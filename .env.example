# Local only. Never commit .env or paste keys into chat.
PYTHONUTF8=1
DATABASE_URL=
DAY6_READ_ONLY=1
DAY6_STRATEGY=B
DAY6_DATA_DIR=data/day6
EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
CHAT_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=openai/gpt-4.1-mini
CHAT_API_KEY=
# Bonus direct providers; selected explicitly in configs/bonus/*.json.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Set true only when this corpus may be processed by the configured service.
ALLOW_EXTERNAL_PROCESSING=false
REQUEST_TIMEOUT_SECONDS=60
